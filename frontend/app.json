{
  "expo": {
    "name": "FarmDirect",
    "slug": "farmdirect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmdirect.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      },
      "package": "com.farmdirect.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-asset"
    ],
    "scheme": "farmdirect",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bd776e8-441d-4c9f-b181-7dfb4c1bcd0a"
      }
    }
  }
}
